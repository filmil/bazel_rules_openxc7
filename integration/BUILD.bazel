load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load(
    "@rules_openxc7//openxc7:defs.bzl",
    "vivado_place_and_route",
    "vivado_program_device",
    "vivado_project",
    "vivado_synthesis",
)
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "@rules_vivado//build/vivado:rules.bzl",
    vivado_emulated_place_and_route = "vivado_place_and_route",
    vivado_emulated_project = "vivado_project",
    vivado_emulated_synthesis = "vivado_synthesis",
)
load("@rules_vivado//internal:toolchain.bzl", "vivado_toolchain")

bool_flag(
    name = "emulate",
    build_setting_default = True,
)

config_setting(
    name = "emulating",
    flag_values = {":emulate": "True"},
)

vivado_toolchain(
    name = "openxc7_vivado",
    mode = "host",
    runner = "@rules_openxc7//vivado:runner",
    vivado_path = "/rules_openxc7/vivado",
    vivado_version = "openxc7",
)

toolchain(
    name = "openxc7_vivado_toolchain",
    target_settings = [":emulating"],
    toolchain = ":openxc7_vivado",
    toolchain_type = "@rules_vivado//toolchains:toolchain_type",
)

# A consumer's view of the module: rules_vivado's blinky, built to a
# bitstream with the prebuilt open toolchain. This is what the Bazel
# Central Registry presubmit runs.
vivado_project(
    name = "blinky",
    srcs = ["blinky.sv"],
    defines = ["FPGA_XILINX=1"],
    part = "xc7a200tfbg484-2",
    top_level = "up_counter",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_synthesis(
    name = "blinky_synth",
    project = ":blinky",
)

vivado_place_and_route(
    name = "blinky_pnr",
    synthesis = ":blinky_synth",
)

vivado_program_device(
    name = "blinky_prog",
    deps = [":blinky_pnr"],
)

# The same design through rules_vivado's own rules, which run on the
# emulated Vivado that MODULE.bazel registers.
vivado_emulated_project(
    name = "blinky_emulated",
    srcs = ["blinky.sv"],
    defines = ["FPGA_XILINX=1"],
    part = "xc7a200tfbg484-2",
    top_level = "up_counter",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_emulated_synthesis(
    name = "blinky_emulated_synth",
    project = ":blinky_emulated",
)

vivado_emulated_place_and_route(
    name = "blinky_emulated_pnr",
    synthesis = ":blinky_emulated_synth",
)

# rules_vivado's rules on the emulated Vivado and rules_openxc7's own rules
# build one design with the same tools, so the configuration data must be
# identical; only the header's design name differs.
sh_test(
    name = "same_bitstream_test",
    size = "small",
    srcs = ["same_bitstream_test.sh"],
    # rules_vivado's rule gives its work directories as well as the .bit,
    # so the reference goes first and the script finds the .bit in the rest.
    args = [
        "$(rootpath :blinky_pnr)",
        "$(rootpaths :blinky_emulated_pnr)",
    ],
    data = [
        ":blinky_emulated_pnr",
        ":blinky_pnr",
    ],
)

vivado_project(
    name = "blinky_vhdl",
    srcs = ["blinky_vhdl.vhd"],
    part = "xc7a200tfbg484-2",
    top_level = "up_counter_vhdl",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_synthesis(
    name = "blinky_vhdl_synth",
    project = ":blinky_vhdl",
)

vivado_place_and_route(
    name = "blinky_vhdl_pnr",
    synthesis = ":blinky_vhdl_synth",
)

vivado_emulated_project(
    name = "blinky_vhdl_emulated",
    srcs = ["blinky_vhdl.vhd"],
    part = "xc7a200tfbg484-2",
    top_level = "up_counter_vhdl",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_emulated_synthesis(
    name = "blinky_vhdl_emulated_synth",
    project = ":blinky_vhdl_emulated",
)

vivado_emulated_place_and_route(
    name = "blinky_vhdl_emulated_pnr",
    synthesis = ":blinky_vhdl_emulated_synth",
)

sh_test(
    name = "same_bitstream_test_vhdl",
    size = "small",
    srcs = ["same_bitstream_test.sh"],
    args = [
        "$(rootpath :blinky_vhdl_pnr)",
        "$(rootpaths :blinky_vhdl_emulated_pnr)",
    ],
    data = [
        ":blinky_vhdl_emulated_pnr",
        ":blinky_vhdl_pnr",
    ],
)

vivado_project(
    name = "blinky_sv",
    srcs = ["blinky_sv.sv"],
    part = "xc7a200tfbg484-2",
    systemverilog_parser = "slang",
    top_level = "up_counter_sv",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_synthesis(
    name = "blinky_sv_synth",
    project = ":blinky_sv",
)

vivado_place_and_route(
    name = "blinky_sv_pnr",
    synthesis = ":blinky_sv_synth",
)

vivado_emulated_project(
    name = "blinky_sv_emulated",
    srcs = ["blinky_sv.sv"],
    env = {"OPENXC7_SYSTEMVERILOG_PARSER": "slang"},
    part = "xc7a200tfbg484-2",
    top_level = "up_counter_sv",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_emulated_synthesis(
    name = "blinky_sv_emulated_synth",
    project = ":blinky_sv_emulated",
)

vivado_emulated_place_and_route(
    name = "blinky_sv_emulated_pnr",
    synthesis = ":blinky_sv_emulated_synth",
)

sh_test(
    name = "same_bitstream_test_sv",
    size = "small",
    srcs = ["same_bitstream_test.sh"],
    args = [
        "$(rootpath :blinky_sv_pnr)",
        "$(rootpaths :blinky_sv_emulated_pnr)",
    ],
    data = [
        ":blinky_sv_emulated_pnr",
        ":blinky_sv_pnr",
    ],
)

# Benchmark designs (//integration/bench): PicoRV32 systems, one core and
# sixteen, built by both rule sets. rules_vivado's targets run on the
# emulated Vivado by default, and on a real Vivado with the flags in
# bench/README.md. The sixteen-core targets are manual: they are only for
# the benchmark, and too slow for every CI run.
_PICORV32_DESIGNS = {
    "picorv32": {"cores": 1, "tags": []},
    "picorv32_x16": {"cores": 16, "tags": ["manual"]},
}

[vivado_project(
    name = name,
    srcs = [
        "picorv32_soc.v",
        "third_party/picorv32/picorv32.v",
    ],
    defines = ["SOC_CORES=%d" % d["cores"]],
    part = "xc7a200tfbg484-2",
    tags = d["tags"],
    top_level = "picorv32_soc",
    xdcs = ["alinx-a200t-b.xdc"],
) for name, d in _PICORV32_DESIGNS.items()]

[vivado_synthesis(
    name = name + "_synth",
    project = ":" + name,
    tags = d["tags"],
) for name, d in _PICORV32_DESIGNS.items()]

[vivado_place_and_route(
    name = name + "_pnr",
    synthesis = ":" + name + "_synth",
    tags = d["tags"],
) for name, d in _PICORV32_DESIGNS.items()]

[vivado_emulated_project(
    name = name + "_emulated",
    srcs = [
        "picorv32_soc.v",
        "third_party/picorv32/picorv32.v",
    ],
    defines = ["SOC_CORES=%d" % d["cores"]],
    part = "xc7a200tfbg484-2",
    tags = d["tags"],
    top_level = "picorv32_soc",
    xdcs = ["alinx-a200t-b.xdc"],
) for name, d in _PICORV32_DESIGNS.items()]

[vivado_emulated_synthesis(
    name = name + "_emulated_synth",
    project = ":" + name + "_emulated",
    tags = d["tags"],
) for name, d in _PICORV32_DESIGNS.items()]

[vivado_emulated_place_and_route(
    name = name + "_emulated_pnr",
    synthesis = ":" + name + "_emulated_synth",
    tags = d["tags"],
) for name, d in _PICORV32_DESIGNS.items()]

build_test(
    name = "smoke_test",
    targets = [
        ":blinky_pnr",
        ":blinky_prog",
        ":blinky_emulated_pnr",
        ":blinky_vhdl_pnr",
        ":blinky_vhdl_emulated_pnr",
        ":blinky_sv_pnr",
        ":blinky_sv_emulated_pnr",
        ":picorv32_pnr",
        ":picorv32_emulated_pnr",
        "@rules_openxc7//openxc7:defs",
    ],
)
