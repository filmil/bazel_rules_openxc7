+namespace {
+// The PUDC_B templates are formatted at run time, from a table. Under
+// clang, absl::StrFormat accepts only a format string known at compile
+// time, so these go through abseil's runtime API instead.
+template <typename... Args>
+std::string FormatRuntime(std::string_view format, const Args &...args) {
+  std::string out;
+  absl::FormatUntyped(absl::FormatRawSink(&out),
+                      absl::UntypedFormatSpec(format),
+                      {absl::FormatArg(args)...});
+  return out;
+}
+}  // namespace
+
 struct TileSiteInfo {
   std::string tile;
   std::string site;
