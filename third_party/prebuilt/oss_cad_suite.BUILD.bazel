# YosysHQ's OSS CAD Suite, for Yosys and openFPGALoader. The bin/ entries
# are wrappers that run the suite's own loader and libraries.
package(default_visibility = ["//visibility:public"])

# The libraries directly in lib/; a glob of lib/* names files only, so
# the subdirectories (Python, Tcl, GHDL) stay out.
_LIBS = glob(["lib/*"])

filegroup(
    name = "yosys",
    srcs = ["bin/yosys"],
)

filegroup(
    name = "yosys_files",
    srcs = [
        "bin/yosys-abc",
        "libexec/yosys",
        "libexec/yosys-abc",
    ] + _LIBS + glob(["share/yosys/**"]),
)

filegroup(
    name = "openfpgaloader",
    srcs = ["bin/openFPGALoader"],
)

filegroup(
    name = "openfpgaloader_files",
    srcs = ["libexec/openFPGALoader"] + _LIBS + glob(["share/openFPGALoader/**"]),
)

# The bundle's top directories as whole directories, for rules_openxc7's
# emulated Vivado runner. rules_vivado's synthesis action copies every
# .tcl, .v, .sv and .vhd file it finds under its working directory, the
# runner's runfiles included; a directory input is placed as one symlink,
# which `find` does not descend into. The bundle is pinned by sha256, so a
# directory input's weaker change tracking costs nothing.
filegroup(
    name = "tree",
    srcs = [
        "bin",
        "lib",
        "libexec",
        "share",
    ],
)
